# ============================================================================
# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and must NEVER be committed. For deploy, set the same variables
# in Vercel > Project Settings > Environment Variables.
#
# NEXT_PUBLIC_* is compiled into the browser bundle. Only safe-to-be-public
# values may use that prefix. Everything else is server-only.
# ============================================================================

# ---- Supabase (public — safe to expose; RLS protects the data) --------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (SECRET — server only, bypasses RLS, treat like a password) ---
# Only used by app/lib/supabase/admin.ts for trusted jobs (cron). Do not add
# NEXT_PUBLIC_ to this. Do not import it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Feature flags (public) ------------------------------------------------
# Comma list of features ON in production. Empty = only finished features.
# In dev everything is on regardless.
NEXT_PUBLIC_FLAGS=

# ---- PM-AI (SECRET — server only) -----------------------------------------
GROK_API_KEY=
ANTHROPIC_API_KEY=

# ---- Rate limiting for the PM-AI route (SECRET — server only) -------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- YouTube Data API (SECRET — server only, used at import time) ---------
YOUTUBE_API_KEY=

# ---- Analytics (public) --------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# ---- Cron shared secret (SECRET — server only) ---------------------------
CRON_SECRET=
